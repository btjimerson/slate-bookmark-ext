{
  "manifest_version": 3,
  "name": "Slate Bookmarks",
  "version": "0.1.0",
  "description": "Save the current tab to Slate with one click.",
  "permissions": ["activeTab"],
  "action": {
    "default_title": "Save to Slate"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Save the current tab to Slate"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
